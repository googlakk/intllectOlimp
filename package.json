{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "check:architecture": "pnpm --filter ./scripts run check:architecture",
    "check:agent-system": "pnpm --filter ./scripts run check:agent-system",
    "check:quality": "./check-quality.sh",
    "perf:lesson": "cd backend && ../.venv/bin/python perf_harness.py",
    "perf:lesson:browser": "pnpm --filter ./scripts run perf:lesson:browser",
    "perf:lesson:browser:auth": "pnpm --filter ./scripts run perf:lesson:browser:auth",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:run": "pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run test:run"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
