# ── База ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:ПАРОЛЬ@ХОСТ:5432/postgres

# ── Модели: куда идёт какая задача ─────────────────────────────────────────
# Без единой строки ниже всё работает как раньше — прямой Anthropic.
#
# Поставщик по умолчанию: anthropic | openrouter
# LLM_PROVIDER=openrouter
#
# Поставщик для отдельной задачи — важнее общего:
# LLM_PROVIDER_KTP_COLUMNS=openrouter
# LLM_PROVIDER_LESSON=anthropic
#
# Модель для задачи. Имена у поставщиков разные:
#   anthropic   → claude-sonnet-4-6
#   openrouter  → anthropic/claude-sonnet-4.6, google/gemini-3-pro, ...
#
# Разбор колонок КТП — ответ в десяток чисел, хватит модели попроще:
# LLM_MODEL_KTP_COLUMNS=anthropic/claude-haiku-4.5
#
# Генерация урока — содержательная работа, нужна сильная модель:
# LLM_MODEL_LESSON=anthropic/claude-sonnet-4.6

# ── Ключи ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=        # нужен не всем ключам, можно не заполнять

# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://ваш-домен            # необязательно
# OPENROUTER_APP_TITLE=Intellect Olimp             # необязательно
# OPENROUTER_TIMEOUT=180
