# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в git не попадает — он в .gitignore.

# Строка подключения к вашей базе Supabase.
# Где взять: Supabase → ваш проект → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@db.ВАШ-ПРОЕКТ.supabase.co:5432/postgres

# Ключ Anthropic для генерации уроков.
# Где взять: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Откуда фронтенду разрешено обращаться к API (для локального запуска менять не нужно)
FRONTEND_ORIGIN=http://localhost:5173
