# Backend (backend/.env)
DATABASE_URL=postgresql://intellect:intellect@localhost:5432/intellect
TEST_DATABASE_URL=postgresql://intellect:intellect@localhost:5432/intellect_test
FRONTEND_ORIGIN=http://localhost:5173
# random string >= 32 chars: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=
# true in production (HTTPS)
COOKIE_SECURE=false
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Frontend (vite)
PORT=5173
BASE_PATH=/

# BilimOs integration (leave empty to disable)
BILIMOS_URL=
# shared with BilimOs: platform -> BilimOs roster fetch
OLIMP_ROSTER_KEY=
# shared with BilimOs: BilimOs -> platform change signal
OLIMP_SYNC_SECRET=
# Ed25519 public key (PEM SPKI) of BilimOs SSO tokens; "\n" escapes allowed in one line
OLIMP_SSO_PUBLIC_KEY=
