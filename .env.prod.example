# Скопируйте в .env.prod и заполните. Файл .env.prod не коммитить.

# Postgres (контейнер db)
POSTGRES_USER=olimp
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=olimp
# Подключение API к db (те же логин/пароль/база; хост — имя сервиса db)
DATABASE_URL=postgresql+asyncpg://olimp:CHANGE_ME_long_random@db:5432/olimp

# Подпись сессионных cookie, >= 32 символов: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=CHANGE_ME
# Cookie только по HTTPS
COOKIE_SECURE=true
# Публичный адрес платформы (CORS), через запятую если несколько
FRONTEND_ORIGIN=https://olimp.example.kg
# Срок жизни сессии в днях (необязательно, по умолчанию 7)
SESSION_TTL_DAYS=7
# Папка собранного фронтенда внутри образа (уже задана в Dockerfile)
STATIC_DIR=/app/static

# Интеграция с BilimOs (пусто = выключено); внутренний адрес по docker-сети
BILIMOS_URL=http://app:3000
# Общий ключ: платформа -> BilimOs, выгрузка списка допущенных
OLIMP_ROSTER_KEY=CHANGE_ME
# Общий секрет: BilimOs -> платформа, сигнал об изменениях
OLIMP_SYNC_SECRET=CHANGE_ME
# Ed25519 публичный ключ (PEM SPKI) SSO-токенов BilimOs, одной строкой с \n
OLIMP_SSO_PUBLIC_KEY=

# AI-генерация (необязательно)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Имя внешней docker-сети BilimOs (читает docker compose, по умолчанию bilimos_default)
BILIMOS_NETWORK=bilimos_default
